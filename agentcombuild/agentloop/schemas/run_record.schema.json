{"$id": "agentloop/run-record-0.1", "title": "RUN record",
 "description": "Every agent run ends with exactly one record. next10 holds exactly 10 tasks; visionary holds >=1 idea; working claims name validations; failures name fixtures.",
 "type": "object",
 "required": ["run_id", "project", "attempt", "working", "not_working", "next10", "visionary"],
 "properties": {
  "run_id": {"type": "string"}, "project": {"type": "string"}, "attempt": {"type": "string"},
  "working": {"type": "array", "items": {"type": "object", "required": ["claim", "validation"]}},
  "not_working": {"type": "array", "items": {"type": "object", "required": ["claim", "failure", "fixture"]}},
  "next10": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object",
    "required": ["task", "justification", "impact"],
    "properties": {"impact": {"type": "integer", "minimum": 1, "maximum": 5}}}},
  "visionary": {"type": "array", "minItems": 1, "items": {"type": "object",
    "required": ["idea", "endgame_link", "falsifier"]}}}}
