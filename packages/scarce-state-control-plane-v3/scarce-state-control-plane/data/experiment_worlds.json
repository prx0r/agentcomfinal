{
  "version": "3.0.0",
  "invariant": "Choose the cheapest real environment that can materially falsify or strengthen the current claim. Simulation may rank experiments but cannot graduate a claim.",
  "formula": "ExperimentValue=(information_gain*feedback_quality*economic_relevance)/(money_cost_factor*time_factor*human_burden_factor*irreversibility_factor)",
  "classes": [
    {
      "id": "A_TRUTH",
      "name": "Truth experiment",
      "question": "Does the causal hypothesis predict external reality?",
      "examples": [
        "paper_trading",
        "frozen_forecast"
      ],
      "graduation_signal": "resolved external outcome"
    },
    {
      "id": "B_DEMAND",
      "name": "Demand experiment",
      "question": "Will a user voluntarily invoke/use this?",
      "examples": [
        "chatgpt_app",
        "free_tool",
        "landing_page"
      ],
      "graduation_signal": "real usage/repeat/intent events"
    },
    {
      "id": "C_ECONOMIC",
      "name": "Economic experiment",
      "question": "Will someone exchange money or accept a concrete economic tradeoff?",
      "examples": [
        "etsy_listing",
        "paid_pilot",
        "marketplace_sale"
      ],
      "graduation_signal": "real purchase/payment/accepted commercial action"
    },
    {
      "id": "D_SCARCE_STATE",
      "name": "Scarce-state experiment",
      "question": "Can we acquire durable consequential state that perfect software cannot synthesize?",
      "examples": [
        "delegated_business_permission",
        "real_transaction_outcome",
        "verified_physical_observation",
        "network_participant"
      ],
      "graduation_signal": "verified ledger-incrementing receipt"
    }
  ],
  "worlds": [
    {
      "id": "paper_trading",
      "class": "A_TRUTH",
      "money_cost": 0,
      "feedback_hours": 24,
      "human_minutes": 5,
