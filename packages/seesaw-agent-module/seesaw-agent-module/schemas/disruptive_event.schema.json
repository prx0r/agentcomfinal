{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisruptiveEvent",
  "type": "object",
  "required": [
    "id",
    "name",
    "date",
    "deltas"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "deltas": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}