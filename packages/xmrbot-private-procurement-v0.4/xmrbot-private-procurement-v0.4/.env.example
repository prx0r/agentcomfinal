# Private-economy provider adapters
KYCNOT_API_KEY=
ORBITSWAP_API_KEY=
XMRCHECKOUT_URL=http://127.0.0.1:8080
XMRCHECKOUT_API_KEY=
BASICSWAP_URL=http://127.0.0.1:12700
BASICSWAP_PASSWORD=
XMRBOT_HAVENO_BRIDGE_URL=
MONERO_WALLET_RPC_URL=http://127.0.0.1:18088/json_rpc

# There is intentionally no global XMRBOT_AUTO_SPEND flag.
# Consequential provider actions require exact QP grants in the execution layer.
