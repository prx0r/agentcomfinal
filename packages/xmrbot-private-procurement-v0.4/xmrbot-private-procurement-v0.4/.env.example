XMRBOT_DB_PATH=./xmrbot.db
XMRBOT_XMR_USD=500
XMRBOT_MONEROD_ENABLED=0
XMRBOT_MONEROD_URL=http://127.0.0.1:18081
XMRBOT_NETWORK_HASHRATE_HS=5900000000
XMRBOT_BLOCK_REWARD_XMR=0.6
XMRBOT_BLOCK_TARGET_SECONDS=120
